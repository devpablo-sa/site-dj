{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "RPN Som e Iluminações — extracted from index.html (2026-09-13). Three-layer token architecture: primitive (raw values) -> semantic (purpose aliases, theme-switchable) -> component (per-component specs).",

  "primitive": {
    "color": {
      "ink": {
        "950": { "$value": "#14111C", "$type": "color", "$description": "Fixed-dark surface: hero, band-ink, final CTA — same in both themes" },
        "900": { "$value": "#1F1A2A", "$type": "color" },
        "850": { "$value": "#1A1624", "$type": "color", "$description": "Card-on-dark surface (diff-item, orc-form, photo-gallery figure). Previously hardcoded, not a variable." }
      },
      "paper": {
        "50": { "$value": "#FAF6EF", "$type": "color" },
        "100": { "$value": "#F1EADC", "$type": "color" }
      },
      "plum": {
        "900": { "$value": "#221D2C", "$type": "color", "$description": "Body text, light theme" },
        "950": { "$value": "#221605", "$type": "color", "$description": "Text on amber fill (buttons, icon glyphs)" }
      },
      "neutral": {
        "200": { "$value": "#F3EEE6", "$type": "color", "$description": "on-ink text" },
        "250": { "$value": "#B8AFC4", "$type": "color", "$description": "on-ink muted text" },
        "400": { "$value": "#8A8098", "$type": "color", "$description": "on-ink muted, secondary variant — hardcoded in 5 places today (hero trust label, form labels/notes); formalized here" },
        "500": { "$value": "#6B6277", "$type": "color", "$description": "muted text, light theme" },
        "300": { "$value": "#E4DBC8", "$type": "color", "$description": "border, light theme" },
        "800": { "$value": "#322B3D", "$type": "color", "$description": "border, on-ink / dark theme" }
      },
      "amber": {
        "600": { "$value": "#C97F17", "$type": "color", "$description": "amber, light theme" },
        "400": { "$value": "#E3A13A", "$type": "color", "$description": "amber-fill, light theme" },
        "300": { "$value": "#F0B457", "$type": "color", "$description": "amber / amber-fill, dark theme" }
      },
      "magenta": {
        "700": { "$value": "#9A2C71", "$type": "color", "$description": "magenta, light theme" },
        "500": { "$value": "#D6409F", "$type": "color", "$description": "magenta-fill, light theme" },
        "400": { "$value": "#E762B4", "$type": "color", "$description": "magenta / magenta-fill, dark theme" }
      },
      "blue": {
        "500": { "$value": "#2F6FEA", "$type": "color", "$description": "focus ring, both themes" }
      }
    },

    "fontFamily": {
      "display": { "$value": "'Bebas RPN', system-ui, sans-serif", "$type": "fontFamily", "$description": "Condensed uppercase display face — H1/H2, big numerals, brand mark" },
      "body": { "$value": "'Manrope RPN', system-ui, sans-serif", "$type": "fontFamily", "$description": "UI/body sans" },
      "mono": { "$value": "'Plex RPN', ui-monospace, monospace", "$type": "fontFamily", "$description": "Labels, eyebrows, nav, timestamps, form micro-copy" }
    },

    "fontSize": {
      "3xs": { "$value": "0.6rem", "$type": "dimension" },
      "2xs": { "$value": "0.7rem", "$type": "dimension", "$description": "consolidates .68/.7/.72rem found in source" },
      "xs": { "$value": "0.75rem", "$type": "dimension", "$description": "consolidates .74/.76/.78rem found in source" },
      "sm": { "$value": "0.8rem", "$type": "dimension" },
      "sm-md": { "$value": "0.88rem", "$type": "dimension" },
      "base-tight": { "$value": "0.95rem", "$type": "dimension", "$description": "consolidates .92/.94/.95/.96rem found in source (secondary paragraph copy)" },
      "base": { "$value": "1rem", "$type": "dimension", "$description": "body copy" },
      "md": { "$value": "1.1rem", "$type": "dimension", "$description": "consolidates 1.08/1.1/1.12rem found in source" },
      "lg": { "$value": "1.15rem", "$type": "dimension" },
      "lg-xl": { "$value": "1.2rem", "$type": "dimension" },
      "xl": { "$value": "1.3rem", "$type": "dimension" },
      "2xl": { "$value": "1.7rem", "$type": "dimension" },
      "display-sm": { "$value": "clamp(1.8rem, 3.6vw, 2.5rem)", "$type": "dimension", "$description": "section h2" },
      "display-md": { "$value": "clamp(1.9rem, 4vw, 2.7rem)", "$type": "dimension", "$description": "final CTA h2" },
      "display-lg": { "$value": "clamp(2.6rem, 6.4vw, 4.6rem)", "$type": "dimension", "$description": "hero h1" }
    },

    "spacing": {
      "1": { "$value": "0.4rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.65rem", "$type": "dimension" },
      "4": { "$value": "0.7rem", "$type": "dimension" },
      "5": { "$value": "0.75rem", "$type": "dimension" },
      "6": { "$value": "0.8rem", "$type": "dimension" },
      "7": { "$value": "0.85rem", "$type": "dimension" },
      "8": { "$value": "0.9rem", "$type": "dimension" },
      "9": { "$value": "1rem", "$type": "dimension" },
      "10": { "$value": "1.15rem", "$type": "dimension" },
      "11": { "$value": "1.25rem", "$type": "dimension" },
      "12": { "$value": "1.35rem", "$type": "dimension" },
      "13": { "$value": "1.5rem", "$type": "dimension" },
      "14": { "$value": "1.6rem", "$type": "dimension" },
      "15": { "$value": "1.75rem", "$type": "dimension" },
      "16": { "$value": "2rem", "$type": "dimension" },
      "17": { "$value": "2.25rem", "$type": "dimension" },
      "18": { "$value": "2.5rem", "$type": "dimension" },
      "19": { "$value": "3rem", "$type": "dimension" }
    },

    "layoutSpacing": {
      "section-y": { "$value": "clamp(3rem, 7vw, 5rem)", "$type": "dimension" },
      "hero-y-top": { "$value": "clamp(4rem, 10vw, 7rem)", "$type": "dimension" },
      "hero-y-bottom": { "$value": "clamp(3.5rem, 8vw, 5.5rem)", "$type": "dimension" },
      "intro-y-top": { "$value": "clamp(2rem, 5vw, 3rem)", "$type": "dimension" }
    },

    "radius": {
      "sm": { "$value": "2px", "$type": "dimension", "$description": "buttons, form fields" },
      "md": { "$value": "3px", "$type": "dimension", "$description": "cards, media frames" },
      "lg": { "$value": "4px", "$type": "dimension", "$description": "form panel" },
      "full": { "$value": "50%", "$type": "dimension", "$description": "timeline marker" }
    }
  },

  "semantic": {
    "color": {
      "ink": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "ink-2": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "ink-3": { "$value": "{primitive.color.ink.850}", "$type": "color", "$description": "new name for the previously-hardcoded #1A1624 card-on-dark surface" },
      "paper": { "$value": "{primitive.color.paper.50}", "$type": "color", "$themeable": true },
      "paper-2": { "$value": "{primitive.color.paper.100}", "$type": "color", "$themeable": true },
      "text": { "$value": "{primitive.color.plum.900}", "$type": "color", "$themeable": true },
      "muted": { "$value": "{primitive.color.neutral.500}", "$type": "color", "$themeable": true },
      "border": { "$value": "{primitive.color.neutral.300}", "$type": "color", "$themeable": true },
      "amber": { "$value": "{primitive.color.amber.600}", "$type": "color", "$themeable": true },
      "amber-fill": { "$value": "{primitive.color.amber.400}", "$type": "color", "$themeable": true },
      "magenta": { "$value": "{primitive.color.magenta.700}", "$type": "color", "$themeable": true },
      "magenta-fill": { "$value": "{primitive.color.magenta.500}", "$type": "color", "$themeable": true },
      "focus": { "$value": "{primitive.color.blue.500}", "$type": "color" },
      "on-ink": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
      "on-ink-muted": { "$value": "{primitive.color.neutral.250}", "$type": "color" },
      "on-ink-muted-2": { "$value": "{primitive.color.neutral.400}", "$type": "color", "$description": "formalizes the hardcoded #8A8098 used for hero trust labels + form labels/notes" },
      "on-ink-border": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
      "on-amber": { "$value": "{primitive.color.plum.950}", "$type": "color", "$description": "text/icon glyph color on top of amber-fill" }
    },
    "font": {
      "display": { "$value": "{primitive.fontFamily.display}", "$type": "fontFamily" },
      "body": { "$value": "{primitive.fontFamily.body}", "$type": "fontFamily" },
      "mono": { "$value": "{primitive.fontFamily.mono}", "$type": "fontFamily" }
    },
    "fontSize": {
      "label": { "$value": "{primitive.fontSize.2xs}", "$type": "dimension", "$description": "eyebrow, form labels, timeline chevron" },
      "caption": { "$value": "{primitive.fontSize.xs}", "$type": "dimension", "$description": "breadcrumb, mono captions, footer" },
      "nav": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "button": { "$value": "{primitive.fontSize.sm-md}", "$type": "dimension" },
      "body-sm": { "$value": "{primitive.fontSize.base-tight}", "$type": "dimension", "$description": "secondary paragraph copy inside cards/items" },
      "body": { "$value": "{primitive.fontSize.base}", "$type": "dimension" },
      "heading-sm": { "$value": "{primitive.fontSize.md}", "$type": "dimension", "$description": "card/timeline/diff-item headings" },
      "heading-md": { "$value": "{primitive.fontSize.lg}", "$type": "dimension" },
      "brand": { "$value": "{primitive.fontSize.xl}", "$type": "dimension" },
      "stat": { "$value": "{primitive.fontSize.2xl}", "$type": "dimension", "$description": "hero trust numbers" },
      "heading-lg": { "$value": "{primitive.fontSize.display-sm}", "$type": "dimension" },
      "heading-xl": { "$value": "{primitive.fontSize.display-md}", "$type": "dimension" },
      "heading-hero": { "$value": "{primitive.fontSize.display-lg}", "$type": "dimension" }
    },
    "spacing": {
      "gap-xs": { "$value": "{primitive.spacing.1}", "$type": "dimension" },
      "gap-sm": { "$value": "{primitive.spacing.5}", "$type": "dimension" },
      "gap-md": { "$value": "{primitive.spacing.9}", "$type": "dimension" },
      "gap-lg": { "$value": "{primitive.spacing.15}", "$type": "dimension" },
      "card-padding-x": { "$value": "{primitive.spacing.13}", "$type": "dimension" },
      "card-padding-y": { "$value": "{primitive.spacing.14}", "$type": "dimension" },
      "panel-padding": { "$value": "{primitive.spacing.13}", "$type": "dimension" },
      "section-y": { "$value": "{primitive.layoutSpacing.section-y}", "$type": "dimension" }
    },
    "radius": {
      "control": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "surface": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "panel": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "marker": { "$value": "{primitive.radius.full}", "$type": "dimension" }
    }
  },

  "component": {
    "button": {
      "font": { "$value": "{semantic.font.body}", "$type": "fontFamily" },
      "font-weight": { "$value": "700", "$type": "fontWeight" },
      "font-size": { "$value": "{semantic.fontSize.button}", "$type": "dimension" },
      "padding-x": { "$value": "1.15rem", "$type": "dimension" },
      "padding-y": { "$value": "0.65rem", "$type": "dimension" },
      "radius": { "$value": "{semantic.radius.control}", "$type": "dimension" },
      "variants": {
        "amber": {
          "bg": { "$value": "{semantic.color.amber-fill}", "$type": "color" },
          "fg": { "$value": "{semantic.color.on-amber}", "$type": "color" },
          "hover": { "$value": "filter: brightness(1.06)", "$type": "other" }
        },
        "ghost-on-ink": {
          "bg": { "$value": "transparent", "$type": "color" },
          "fg": { "$value": "{semantic.color.on-ink}", "$type": "color" },
          "border": { "$value": "rgba(243,238,230,.4)", "$type": "color" },
          "hover-border": { "$value": "#F3EEE6", "$type": "color" }
        },
        "line": {
          "bg": { "$value": "transparent", "$type": "color" },
          "fg": { "$value": "{semantic.color.text}", "$type": "color" },
          "border": { "$value": "{semantic.color.border}", "$type": "color" },
          "hover-border": { "$value": "{semantic.color.amber}", "$type": "color" }
        }
      }
    },

    "service-card": {
      "bg": { "$value": "{semantic.color.paper-2}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.surface}", "$type": "dimension" },
      "padding-x": { "$value": "1.5rem", "$type": "dimension" },
      "padding-y": { "$value": "1.6rem", "$type": "dimension" },
      "icon-size": { "$value": "2.4rem", "$type": "dimension" },
      "icon-bg": { "$value": "{semantic.color.amber-fill}", "$type": "color" },
      "icon-fg": { "$value": "{semantic.color.on-amber}", "$type": "color" },
      "heading-size": { "$value": "{semantic.fontSize.heading-sm}", "$type": "dimension" },
      "body-size": { "$value": "{semantic.fontSize.body-sm}", "$type": "dimension" },
      "body-color": { "$value": "{semantic.color.muted}", "$type": "color" }
    },

    "diff-item": {
      "bg": { "$value": "{semantic.color.ink-3}", "$type": "color" },
      "padding-x": { "$value": "1.6rem", "$type": "dimension" },
      "padding-y": { "$value": "1.75rem", "$type": "dimension" },
      "eyebrow-color": { "$value": "{semantic.color.amber-fill}", "$type": "color", "$description": "the .n index label, hardcoded to dark-mode amber regardless of theme (this band is fixed-dark)" },
      "heading-color": { "$value": "{semantic.color.on-ink}", "$type": "color" },
      "body-color": { "$value": "{semantic.color.on-ink-muted}", "$type": "color" }
    },

    "timeline-marker": {
      "size": { "$value": "3rem", "$type": "dimension" },
      "radius": { "$value": "{semantic.radius.marker}", "$type": "dimension" },
      "border": { "$value": "{semantic.color.amber-fill}", "$type": "color" },
      "bg": { "$value": "{semantic.color.paper}", "$type": "color" },
      "fg": { "$value": "{semantic.color.amber}", "$type": "color" },
      "connector": { "$value": "{semantic.color.border}", "$type": "color" }
    },

    "media-frame": {
      "radius": { "$value": "{semantic.radius.surface}", "$type": "dimension" },
      "border": { "$value": "1px dashed {semantic.color.border}", "$type": "other", "$description": "placeholder frames (.frame)" },
      "photo-border": { "$value": "1px solid {semantic.color.border}", "$type": "other", "$description": "real photos (.photo-gallery figure)" },
      "photo-bg": { "$value": "{semantic.color.ink-3}", "$type": "color" },
      "caption-fg": { "$value": "{semantic.color.on-ink}", "$type": "color" },
      "caption-scrim": { "$value": "linear-gradient(to top, rgba(20,17,28,.78), transparent)", "$type": "other" }
    },

    "form-panel": {
      "bg": { "$value": "{semantic.color.ink-3}", "$type": "color" },
      "border": { "$value": "rgba(243,238,230,.14)", "$type": "color" },
      "radius": { "$value": "{semantic.radius.panel}", "$type": "dimension" },
      "padding": { "$value": "{semantic.spacing.panel-padding}", "$type": "dimension" },
      "field-bg": { "$value": "{semantic.color.ink-3}", "$type": "color" },
      "field-border": { "$value": "rgba(243,238,230,.2)", "$type": "color" },
      "field-radius": { "$value": "{semantic.radius.control}", "$type": "dimension" },
      "field-fg": { "$value": "{semantic.color.on-ink}", "$type": "color" },
      "field-placeholder": { "$value": "{semantic.color.on-ink-muted-2}", "$type": "color" },
      "label-color": { "$value": "{semantic.color.on-ink-muted-2}", "$type": "color" },
      "label-size": { "$value": "{semantic.fontSize.label}", "$type": "dimension" }
    },

    "faq": {
      "divider": { "$value": "{semantic.color.border}", "$type": "color" },
      "summary-size": { "$value": "{semantic.fontSize.body}", "$type": "dimension" },
      "summary-weight": { "$value": "700", "$type": "fontWeight" },
      "chevron-color": { "$value": "{semantic.color.amber}", "$type": "color" },
      "answer-color": { "$value": "{semantic.color.muted}", "$type": "color" },
      "answer-max-width": { "$value": "64ch", "$type": "dimension" }
    }
  },

  "dark": {
    "semantic": {
      "color": {
        "paper": { "$value": "{primitive.color.ink.950}", "$type": "color" },
        "paper-2": { "$value": "{primitive.color.ink.900}", "$type": "color" },
        "text": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
        "muted": { "$value": "{primitive.color.neutral.250}", "$type": "color" },
        "border": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
        "amber": { "$value": "{primitive.color.amber.300}", "$type": "color" },
        "amber-fill": { "$value": "{primitive.color.amber.300}", "$type": "color" },
        "magenta": { "$value": "{primitive.color.magenta.400}", "$type": "color" },
        "magenta-fill": { "$value": "{primitive.color.magenta.400}", "$type": "color" }
      }
    }
  }
}
